# 可选：如果不希望每次在页面中填写 AI 设置，可在启动前配置这些环境变量。
AI_ENDPOINT=https://api.example.com/v1/chat/completions
AI_MODEL=YOUR_MODEL_NAME
AI_API_KEY=YOUR_API_KEY_HERE

# Google Cloud Run / Google Sheets 主数据源。
REVIEW_SPREADSHEET_ID=1py3sy7Cf2HCTxdhrRhFGoYzrnLRomOrNrTJU7KrGKUE
ISSUES_SHEET_NAME=Issues
QUESTIONS_SHEET_NAME=Questions
ACCESS_REQUESTS_SHEET_NAME=AccessRequests

# Google OAuth 登录与管理员授权。
# AUTH_URL 必须与 Google OAuth 控制台中的已授权重定向 URI 使用同一域名。
AUTH_URL=https://YOUR_CLOUD_RUN_URL
AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
ADMIN_EMAILS=admin@example.com

# 可选：只允许指定 Google Workspace 域，多个域使用英文逗号分隔。
GOOGLE_ALLOWED_DOMAINS=

# 可选：供会议提炼流程把新问题写入 Questions；请使用随机长字符串并放在 Cloud Run Secret 中。
QUESTION_SYNC_TOKEN=YOUR_RANDOM_SYNC_TOKEN_HERE

# 可选：修改端口或本地数据目录。
PORT=4173
REVIEW_DATA_DIR=./data
REVIEW_BACKUP_DIR=./backups

# 仅限本地开发；生产环境会忽略此项。
DEV_AUTH_EMAIL=admin@example.com
